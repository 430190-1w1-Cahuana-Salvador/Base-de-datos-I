--monto total facturado en el 2020 y el promedio de faturación
SELECT SUM(cantidad * pre_unitario) Total,
AVG(cantidad * pre_unitario) 'promedio por detalle',
COUNT(*) 'cantidad de detalles',
SUM(cantidad*pre_unitario) / COUNT(DISTINCT F.nro_factura) 'Prom.Xfactura'
FROM facturas F JOIN detalle_facturas D ON F.nro_factura = d.nro_factura
WHERE YEAR(fecha) = 2020;

--Se quiere ver la facturacion del 2020 y en el mismo listado, pero en la última fila el total facturado
SELECT STR(F.nro_factura) nro_factura,
cantidad* pre_unitario SUBTOTAL
FROM detalle_facturas D JOIN facturas F ON D.nro_factura = F.nro_factura
WHERE YEAR(fecha) = 2020
UNION
SELECT 'total',
SUM(pre_unitario*cantidad)
FROM detalle_facturas D JOIN facturas F ON D.nro_factura = F.nro_factura
WHERE YEAR(fecha) = 2020;


