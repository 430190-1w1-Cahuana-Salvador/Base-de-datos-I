USE LIBRERIA_2026

REPASO DE SELECT

Listar artículos vendidos en 2020, mostrar precio de venta, cliente que lo compró, vendedor que lo vendió, solo mostrar los artículos cuya descripción comience con las letras que van de la G a la P y los clientes viven en el B°Centro.

SELECT A.descripcion AS 'Producto',
	DF.pre_unitario AS 'Precio Unitario', --precio en ese momento (no actual)
	C.nom_cliente + ' ' + C.ape_cliente AS 'Cliente',
	V.nom_vendedor + ' ' + V.ape_vendedor AS 'Vendedor',
	B2.barrio AS  'Barrio Vendedor'
FROM facturas AS F
	JOIN detalle_facturas AS DF ON DF.nro_factura = F.nro_factura
	JOIN articulos AS A ON A.cod_articulo = DF.cod_articulo
	JOIN clientes AS C ON F.cod_cliente = C.cod_cliente
	JOIN vendedores AS V ON V.cod_vendedor = F.cod_vendedor
	JOIN barrios AS B ON C.cod_barrio = B.cod_barrio
	JOIN barrios AS B2 ON V.cod_barrio = B2.cod_barrio -- barrios de vendedores
WHERE YEAR(F.fecha) = 2020
	AND A.descripcion LIKE '[G-P]%'
	AND B.barrio = 'CENTRO'
	AND B2.barrio = 'CENTRO' -- consigna: y vendedor barrio centro
	

